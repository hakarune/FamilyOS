#!/bin/bash
# FamilyOS parental control CLI - TTY2 entry point.
#
# Intended to run on a text console (TTY2) as an alternative to the
# graphical Parent Panel in the Launcher (see
# launcher/ui/parent_panel.py). Both front ends collect a password and
# pipe it to the same privileged scripts in this directory, which
# perform the actual auth check - see README.md for the full contract.
set -euo pipefail

run_privileged() {
    local script="$1"; shift
    local password
    password=$(whiptail --passwordbox "Parent password:" 10 50 --title "FamilyOS" 3>&1 1>&2 2>&3) || return

    # Must go through sudo at the exact whitelisted path
    # (overlays/etc/sudoers.d/familyos-parent lists
    # /usr/local/bin/familyos-*, not this directory) - toddler has no
    # privilege to reboot/poweroff/change iptables rules otherwise.
    # Calling "$DIR/$script" directly (the previous behavior) silently
    # ran every privileged action as the unprivileged toddler user.
    local output rc
    if output=$(printf '%s' "$password" | sudo "/usr/local/bin/$script" "$@" 2>&1); then
        rc=0
    else
        rc=$?
    fi

    case "$rc" in
        0) whiptail --msgbox "$output" 10 60 --title "Done" ;;
        2) whiptail --msgbox "Not available yet (Phase 3)." 10 60 --title "FamilyOS" ;;
        *) whiptail --msgbox "$output" 10 60 --title "Failed" ;;
    esac
}

run_volume() {
    local cap
    cap=$(whiptail --inputbox "Volume cap (%):" 10 50 "65" --title "FamilyOS" 3>&1 1>&2 2>&3) || return
    run_privileged familyos-volume "$cap"
}

run_remount_rw() {
    local source_path
    source_path=$(whiptail --inputbox "Path to file to add to media folder:" 10 60 --title "FamilyOS" 3>&1 1>&2 2>&3) || return
    run_privileged familyos-remount-rw "$source_path"
}

main_menu() {
    while true; do
        choice=$(whiptail --title "FamilyOS Parent Controls" --menu "Choose an action:" 18 60 7 \
            "1" "Internet: ON" \
            "2" "Internet: OFF" \
            "3" "Remount RW (edit config)" \
            "4" "Adjust Volume Cap" \
            "5" "Reboot" \
            "6" "Shutdown" \
            "7" "Exit" \
            3>&1 1>&2 2>&3) || break

        case "$choice" in
            1) run_privileged familyos-net-toggle on ;;
            2) run_privileged familyos-net-toggle off ;;
            3) run_remount_rw ;;
            4) run_volume ;;
            5) run_privileged familyos-power reboot ;;
            6) run_privileged familyos-power poweroff ;;
            7) break ;;
        esac
    done
}

main_menu
