#!/bin/sh
# Attempts to install and enable the FamilyOS Plymouth boot splash
# (graphics/splash/, installed at /usr/share/plymouth/themes/familyos
# by auto/config). Deliberately isolated from the main package list
# (common/package-lists/familyos.list.chroot) with explicit failure
# tolerance: Debian's stock `plymouth` package depends on
# `systemd (>=232-8) | elogind` and `udev (>=232-8)`. `elogind` and
# Devuan's `eudev` (which should satisfy the udev alternative via
# Provides) are the philosophically correct systemd-free answers here
# - matching how this project already handles `live-config-sysvinit`
# elsewhere - but whether the `systemd | elogind` alternative actually
# made it into the specific plymouth version Devuan daedalus ships is
# NOT confirmed (the fix landed in Debian testing 2023-12-16, after
# both bookworm's freeze and daedalus's release - unclear if it was
# backported). If `apt install` fails here, FamilyOS still boots fine
# with a plain text console - Plymouth is a cosmetic addition, not a
# dependency of anything else in this system.
#
# If this fails on a real build: do NOT reach for the JoeThunder
# out-of-tree plymouth patch some guides suggest for non-systemd
# systems - it's unmerged, experimental, and not reliable enough for
# this project's standards. The correct fix is either confirming a
# working elogind-based plymouth/eudev combination on the actual
# Devuan release in use, or accepting no boot splash.
set -e

if apt-get install -y --no-install-recommends plymouth elogind initramfs-tools; then
    echo "familyos: plymouth installed successfully, enabling theme"
    plymouth-set-default-theme familyos
    update-initramfs -u
else
    echo "familyos: plymouth install failed - continuing WITHOUT a boot splash." >&2
    echo "familyos: this is expected-possible, not a build failure - see this hook's own header comment." >&2
fi
