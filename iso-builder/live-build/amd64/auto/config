#!/bin/sh
# FamilyOS live-build profile: amd64
# ("Standard 10-year-old hardware" - _Base Architecture Overview.md)
set -e
unset CDPATH

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"            # .../amd64/auto
PROFILE_DIR="$(dirname "$SCRIPT_DIR")"                        # .../amd64
LIVE_BUILD_DIR="$(dirname "$PROFILE_DIR")"                    # .../live-build
ISO_BUILDER_DIR="$(dirname "$LIVE_BUILD_DIR")"                # .../iso-builder
REPO_ROOT="$(dirname "$ISO_BUILDER_DIR")"                     # repo root

# common/ and overlays/ are the single sources of truth (see
# Github Project Structure.md) - copied in here rather than
# duplicated by hand. Not committed as repo symlinks because the
# authoring environment's storage backend doesn't support them;
# materializing them here at config-time works on any real build
# machine.
mkdir -p "$PROFILE_DIR/config"
ln -sfn "$LIVE_BUILD_DIR/common/package-lists" "$PROFILE_DIR/config/package-lists"
ln -sfn "$LIVE_BUILD_DIR/common/hooks" "$PROFILE_DIR/config/hooks"

# config/includes.chroot entries are DEREFERENCING COPIES (cp -rL), not
# symlinks. live-build's own handling of symlinks placed inside
# includes.chroot is undocumented and unverified in this authoring
# environment (no live-build tooling available to test against) - a
# naive preserve-the-symlink copy into the chroot would leave
# /opt/familyos/launcher etc. as dangling symlinks pointing at a
# build-host path that doesn't exist on the target, silently breaking
# the entire boot chain (.xinitrc execs a launcher that wouldn't
# exist). Copying real file content here removes that risk entirely,
# at the cost of this config step needing to be re-run to pick up repo
# edits (acceptable - it already needs to be, since `lb config` is
# normally a fresh/explicit step anyway).
CHROOT="$PROFILE_DIR/config/includes.chroot"
rm -rf "${CHROOT:?}/etc" "${CHROOT:?}/home" \
       "${CHROOT:?}/usr/local/lib/familyos/parental-tools" \
       "${CHROOT:?}/opt/familyos/launcher" \
       "${CHROOT:?}/opt/familyos/graphics" \
       "${CHROOT:?}/usr/share/plymouth/themes/familyos"

mkdir -p "$CHROOT"
cp -rL "$REPO_ROOT/overlays/etc" "$CHROOT/etc"
cp -rL "$REPO_ROOT/overlays/home" "$CHROOT/home"

# Installs parental-tools/ and launcher/ at the absolute paths the
# overlays already reference (sudoers.d/familyos-parent,
# .xinitrc/.bash_profile) but that nothing previously materialized -
# see parental-tools/README.md's former "packaging must reconcile"
# open item, resolved here.
mkdir -p "$CHROOT/usr/local/lib/familyos"
cp -rL "$REPO_ROOT/parental-tools" "$CHROOT/usr/local/lib/familyos/parental-tools"
mkdir -p "$CHROOT/opt/familyos"
cp -rL "$REPO_ROOT/launcher" "$CHROOT/opt/familyos/launcher"

# graphics/ (icons, branding, Plymouth theme source - see
# docs/Asset_Sourcing.md and graphics/ASSET_INVENTORY.md) - installed
# as a sibling of launcher/ so the launcher's own install-root-relative
# icon path resolution (see launcher/ui/main_window.py's INSTALL_ROOT)
# finds it, plus the Plymouth theme specifically also needs to land at
# its own required system path.
cp -rL "$REPO_ROOT/graphics" "$CHROOT/opt/familyos/graphics"
mkdir -p "$CHROOT/usr/share/plymouth/themes"
cp -rL "$REPO_ROOT/graphics/splash" "${CHROOT:?}/usr/share/plymouth/themes/familyos"

lb config noauto \
    --distribution daedalus \
    --archive-areas main \
    --mirror-bootstrap http://deb.devuan.org/merged \
    --mirror-binary http://deb.devuan.org/merged \
    --mirror-chroot-security http://deb.devuan.org/merged \
    --mirror-binary-security http://deb.devuan.org/merged \
    --architecture amd64 \
    --linux-flavours amd64 \
    --linux-packages linux-image \
    --initsystem sysvinit \
    --keyring-packages devuan-keyring \
    --bootappend-live "boot=live components live-config.username=toddler persistence persistence-label=familyos-data quiet splash" \
    "${@}"
