#!/bin/bash
# Changes the parent account's own password.
#
# Requires the CURRENT password to verify first (via require_parent_auth,
# the same PAM/pamtester gate every other script here uses) before
# accepting a new one - someone already inside an already-unlocked
# Parent Panel still has to re-prove they know the current password to
# change it. See launcher/ui/parent_panel.py's "Change Parent Password"
# section, which does NOT reuse the panel's own cached unlock-time
# password for this - it re-prompts and sends a freshly-typed current
# password specifically so this re-verification is real, not
# rubber-stamped by an already-open panel.
#
# Protocol: stdin line 1 = current password (consumed by
# require_parent_auth), stdin line 2 = new password. Both via stdin,
# never argv/env - same reason as every other script here (never shows
# up in `ps`).
#
# This is the actual, permanent mechanism for a parent to set/change
# their password - the FAMILYOS_PARENT_PASSWORD build-time preseed (see
# familyos.blend's blend_preinst and
# devuan-build-docs/confirmed-parent-password-preseed.txt) is only a
# starting point, not something a parent is expected to keep using.
set -euo pipefail
DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/require-parent-auth.sh
source "$DIR/lib/require-parent-auth.sh"
# shellcheck source=lib/env-guard.sh
source "$DIR/lib/env-guard.sh"

require_parent_auth

IFS= read -r new_password

MIN_LENGTH=8
if [ -z "$new_password" ]; then
    echo "New password cannot be empty." >&2
    exit 1
fi
if [ "${#new_password}" -lt "$MIN_LENGTH" ]; then
    echo "New password must be at least $MIN_LENGTH characters." >&2
    exit 1
fi

# NOT `printf ... | run_or_dry_run chpasswd`: under this script's own
# set -euo pipefail, that pipeline is a real race in dry-run mode -
# run_or_dry_run's dry-run branch is a bare `echo` that never reads
# stdin, so if it exits before printf finishes writing, printf gets
# SIGPIPE (exit 141), pipefail treats that as the pipeline failing, and
# set -e kills the script before "Password updated." ever prints - an
# independent review reproduced this failing ~10-50% of the time.
# Reverting to a plain if/else avoids the race entirely: the dry-run
# branch never touches the pipe at all (no writer, no reader, nothing
# to race), and the real branch's `printf | chpasswd` is safe because
# chpasswd genuinely reads all of stdin before exiting.
if is_dry_run; then
    echo "[DRY RUN] would execute: chpasswd (set new parent password)"
else
    printf 'parent:%s\n' "$new_password" | chpasswd
fi

echo "Password updated."
